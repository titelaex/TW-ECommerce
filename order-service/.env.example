# Copiati in .env (acelasi folder) si completati. .env NU se urca in git.
# Cu `docker compose up -d` din radacina repo-ului NU aveti nevoie de .env: valorile implicite
# din application.yml (localhost:5433, postgres/postgres) indica deja containerul.
# Completati doar daca folositi alt PostgreSQL (ex. unul instalat local pe 5432).
DB_URL=jdbc:postgresql://localhost:5432/orders_db
DB_USER=postgres
DB_PASSWORD=
EUREKA_URL=http://localhost:8761/eureka
