# Copiati in .env (acelasi folder) si completati. .env NU se urca in git.
# Cale catre cheia de service account (Firebase Console > Project settings > Service accounts).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
EUREKA_URL=http://localhost:8761/eureka
# Atentie: FIRESTORE_EMULATOR_HOST si GOOGLE_APPLICATION_CREDENTIALS le citeste direct SDK-ul Google,
# din variabilele de mediu ale procesului, nu din .env. Pe acelea setati-le in sistem sau in IntelliJ.
